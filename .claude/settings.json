{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/windows 10/.local/bin/graphify.EXE\" hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/windows 10/.local/bin/graphify.EXE\" hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/windows 10/.local/bin/graphify.EXE\" update \"E:/Project/finta\" 2>/dev/null || true",
            "async": true,
            "timeout": 120,
            "statusMessage": "Updating graphify knowledge graph..."
          }
        ]
      }
    ]
  }
}