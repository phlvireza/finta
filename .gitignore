# Claude Code local tooling (not project source)
.agents/
.claude/scheduled_tasks.lock
.claude/settings.local.json
graphify-out/

# Project guidance for Claude Code — local-only, not part of the shipped repo
CLAUDE.md

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Gradle caches under the vendored file_picker fork. These were tracked by
# mistake: they are daemon-owned lock and hash files that change on every
# build, and Windows keeps them open, so git cannot even hash them while a
# Gradle daemon is alive.
vendor/**/.gradle/

# Local-only docs (not pushed to remote) — README and the shared Claude rules
# are the deliberate exceptions.
*.md
!/README.md
!.claude/rules/*.md

# JVM crash dumps left behind by a Gradle daemon that died
hs_err_pid*.log
replay_pid*.log
*.hprof
